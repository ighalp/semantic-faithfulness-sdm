# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
# Allow demo notebooks but ignore temp/checkpoint files
demo_cache/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Data - general patterns
*.csv

# Data files - ignore by default, except for committed cache
*.json
*.pkl
*.npy
*.npz

# But allow cached demo data for reproducibility
!data/cache/**/*.npz
!data/cache/**/*.json
!data/cache/**/*.pkl

# Ignore dynamic results
data/results/

# API Keys and Secrets
.env
*.key
*.pem
secrets/

# Logs
*.log
logs/

# Model checkpoints
*.ckpt
*.pt
*.pth
checkpoints/

# Documentation build
docs/_build/
site/

# Large files
*.zip
*.tar.gz
*.tar
*.rar

# Data directory - examples and cache are committed, results are not
!data/examples/**/*.json
